# --- Vercel + Turso (recommended) --------------------------------------
REALAI_DATABASE_URL=libsql://realai-<you>.turso.io   # turso db show realai --url
REALAI_DATABASE_TOKEN=                               # turso db tokens create realai
REALAI_WEB_TOKEN=                                    # long random string: gates /dashboard /approve /cron/tick
CRON_SECRET=                                         # long random string: Vercel Cron -> /api/cron/tick
REALAI_AGENT_NAME=REAL
REALAI_OWNER_NAME=Owner

# --- optional: Telegram master control (your own bot) ------------------
# REALAI_TELEGRAM_BOT_TOKEN=
# REALAI_TELEGRAM_CHAT_ID=
# REALAI_TELEGRAM_WEBHOOK_SECRET=

# --- optional: local generative backends (NOT on Vercel; a server you own)
# REALAI_LLM_URL=http://127.0.0.1:11434
# REALAI_LLM_MODEL=llama3.1:8b
# REALAI_IMAGE_URL=http://127.0.0.1:7860
# REALAI_STT_URL=http://127.0.0.1:8178
# REALAI_TTS_URL=http://127.0.0.1:5000
