{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,examples/**,**/test_*.py}"
    }
  },
  "rewrites": [
    { "source": "/api/:rest*", "destination": "/api/:rest*" },
    { "source": "/", "destination": "/api" },
    { "source": "/webhook", "destination": "/api/webhook" },
    { "source": "/dashboard", "destination": "/api/dashboard" },
    { "source": "/stream/:topic", "destination": "/api/stream/:topic" },
    { "source": "/:rest*", "destination": "/api/:rest*" }
  ]
}
